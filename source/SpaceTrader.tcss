.interface_left{
    max-width: 100%;
    min-width: 50;
}

.interface_right{
    width: 53;
}

.dialogue_buttons{
    align: center middle;
}

.datatable_buttons{
    align: center middle;
    height: 2;
}

ShipStats{
    border: solid green;
    padding: 0;
    height: 12;
    align: center middle;
}

ShipControls {
    border: solid green;
    padding: 0;
    height: 12;
    align: center middle;
}

ShipComms{
    border: solid green;
    padding: 0;
    width: 100%;
    align: center middle;
}

ShipComms > Log{
    height: 10;
    scrollbar-size: 0 1;
}

Log{
    height: 10;
    scrollbar-size: 0 1;    
}

Button {
    margin: 1;
    border: none;
    text-style: none;
    height: 2;
}

Switch {
    margin: 1 1;
    padding: 0;
    border: none;
    height: 1;
}

ShipLog{
    border: solid green;
    padding: 0;
    width: 100%;
}

ShipLog > Log{
    height: 14;
    scrollbar-size: 0 1;
}

ViewPort{
    width: 100%;
    height: 24;
    border: solid purple;
}

ViewPort > LocationIndicator{
    width: 100%;
    height: 2;
    content-align: center bottom;
    align: center top;
    border-bottom: solid $primary 30%;
    margin-bottom: 0;
}

#viewport_content{
    width: 100%;
    height: 1fr;
    align: center middle;
}

#viewport_content > SystemVisualizer{
    width: 100%;
    height: 100%;
    padding: 0 1;
}

#viewport_content > LongRangeVisualizer{
    width: 100%;
    height: 100%;
    padding: 0 1;
}

#viewport_empty{
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: grey;
}

ViewPort > StatusBar{
    width: 100%;
    content-align: center middle;
    align: center middle;
}

#viewport_content > StatusBar{
    width: 100%;
    content-align: center middle;
    align: center middle;
}


SelectionMenu{
    width: 50;
    height: 11;
    align: center top;
    border: solid blue;
}

SelectionMenu > Label{
    color: red;
    width: 50;
    content-align: center middle;
}

TableList{
    width: 62;
    height: 17;
    align: center top;
    border: solid blue;
}

TableList > .datatable_data{
    height: 10;
}

TableList > Label{
    color: pink;
    width: 50;
    content-align: center middle;
}


Bar > .bar--indeterminate {
    color: $primary;
    background: $secondary;
}

Bar > .bar--bar {
    color: $primary;
    background: $primary 30%;
}

Bar > .bar--complete {
    color: $error;
}
