.interface_left{
    max-width: 100%;
    min-width: 50;
}

.interface_right{
    width: 53;
}

.dialogue_buttons{
    align: center middle;
}

.datatable_buttons{
    align: center middle;
    height: 2;
}

ShipStats{
    border: solid green;
    padding: 0;
    height: 10;
    align: center middle;
}

ShipControls {
    border: solid green;
    padding: 0;
    height: 15;
    align: center middle;
}

ShipControls > VerticalGroup > Label{
    width: 100%;
    content-align: left middle;
    padding: 0 1;
}

ShipComms{
    border: solid green;
    height: 14;
    padding: 0;
    width: 100%;
    align: center top;
}

ShipComms.comms-idle{
    border: solid green;
    background: rgb(6, 20, 10);
}

ShipComms.comms-active{
    border: heavy yellow;
    background: rgb(35, 28, 0);
}

ShipComms.comms-active.comms-alert{
    border: heavy red;
    background: rgb(36, 8, 8);
}

ShipComms > Log{
    height: 5;
    scrollbar-size: 0 1;
}

#comms_menu_box{
    height: 1fr;
    border-top: solid $primary 30%;
    padding: 0 1;
}

#comms_menu_title{
    width: 100%;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

ShipComms.comms-active #comms_menu_title{
    color: black;
    background: yellow;
    text-style: bold;
}

ShipComms.comms-active.comms-alert #comms_menu_title{
    color: white;
    background: red;
    text-style: bold;
}

#comms_menu_options{
    height: 1fr;
}

ShipComms.comms-active #comms_menu_options{
    border: solid yellow;
}

ShipComms.comms-active.comms-alert #comms_menu_options{
    border: solid red;
}

#comms_menu_hint{
    width: 100%;
    content-align: center middle;
    color: grey;
}

ShipComms.comms-active #comms_menu_hint{
    color: yellow;
    text-style: bold;
}

ShipComms.comms-active.comms-alert #comms_menu_hint{
    color: red;
    text-style: bold;
}

Log{
    height: 10;
    scrollbar-size: 0 1;    
}

ShipLog{
    border: solid green;
    padding: 0;
    width: 100%;
    height: 12;
}

ShipLog > Log{
    height: 14;
    scrollbar-size: 0 1;
}

ViewPort{
    width: 100%;
    height: 27;
    border: solid purple;
}

ViewPort > LocationIndicator{
    width: 100%;
    height: 2;
    content-align: center bottom;
    align: center top;
    border-bottom: solid $primary 30%;
    margin-bottom: 0;
}

#viewport_mode_indicator{
    width: 100%;
    height: 1;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#viewport_content{
    width: 100%;
    height: 1fr;
    align: center middle;
}

#viewport_content > SystemVisualizer{
    width: 100%;
    height: 100%;
    padding: 0 1;
}

#viewport_content > LongRangeVisualizer{
    width: 100%;
    height: 100%;
    padding: 0 1;
}

.viewport_empty{
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: grey;
}

ViewPort > StatusBar{
    width: 100%;
    content-align: center middle;
    align: center middle;
}

#viewport_content > StatusBar{
    width: 100%;
    content-align: center middle;
    align: center middle;
}


Bar > .bar--indeterminate {
    color: $primary;
    background: $secondary;
}

Bar > .bar--bar {
    color: $primary;
    background: $primary 30%;
}

Bar > .bar--complete {
    color: $error;
}
